# Перший батьківський клас
class Weapon:
    def __init__(self):
        self.damage = 50  # Ексклюзивний атрибут

    def attack(self):     # Ексклюзивний метод
        print(f"Атака! Нанесено {self.damage} шкоди.")


# Другий батьківський клас
class Shield:
    def __init__(self):
        self.defense = 30  # Ексклюзивний атрибут

    def block(self):       # Ексклюзивний метод
        print(f"Захист! Заблоковано {self.defense} шкоди.")


# Дочірній клас, який успадковується одразу від двох класів
class Hero(Weapon, Shield):
    def __init__(self, name):
        # Викликаємо конструктори обох батьків
        Weapon.__init__(self)
        Shield.__init__(self)
        self.name = name

    def show_info(self):
        print(f"Герой: {self.name}")
        print(f"Шкода: {self.damage}, Захист: {self.defense}")


# Перевірка роботи
hero = Hero("Алекс")

# Виклик власного методу
hero.show_info()

# Виклик ексклюзивного методу від Weapon
hero.attack()

# Виклик ексклюзивного методу від Shield
hero.block()
